# CARE Reporting Studio — environment
# Copy to .env beside docker-compose.yml and edit.

# Port the studio answers on (Synology host)
STUDIO_PORT=3090

# Timezone
TZ=Asia/Kolkata

# Where your existing OHIF listens (care-pacs compose on the same NAS).
# Only needed for the optional /ohif same-origin viewer (see Caddyfile).
# In the Studio app itself, configure OHIF LAN/Tailscale URLs in Settings.
OHIF_UPSTREAM=172.16.1.139:3010

# ── Everything else is configured INSIDE the app (Settings → Integrations) ──
#   CARE API base    e.g. http://172.16.1.139:8888
#   CARE internal API key   (from the CARE ERP .env)
#   Orthanc URL      e.g. http://172.16.1.139:8042 (+ admin user/password)
#   OHIF LAN URL     e.g. http://172.16.1.139:3010
#   OHIF Tailscale URL (optional, for reporting from home)
