// CARE USG Studio — standalone sonography reporting for Dr Sugandha.
// SQLite, additive-first: schema changes must never risk existing reports.
//
// v4 (USG-only): the radiology worklist/reporting tables of the v1-v3
// shared codebase (CareOrderLink, Report, ReportImage, FindingRow,
// QuickPhrase, TechniqueTemplate, ReportFormat, SyncState) and the
// MRI-side settings columns (radiologist*, careApi*, orthanc*, ohif*)
// were REMOVED — this app reports ultrasound only. Upgrade is handled by
// scripts/usg-v4-cleanup.mjs (idempotent; USG data is never touched).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Settings (single row, id = "singleton") ─────────────────────────────
model HospitalSettings {
  id              String   @id @default("singleton")

  // Header / identity — the letterhead on every printed report
  appTitle        String   @default("CARE USG Studio")
  hospitalName    String   @default("")
  addressLine     String   @default("")
  phone           String   @default("")
  email           String   @default("")
  footerMessage   String   @default("")
  logoUrl         String   @default("")

  // Security
  pinHash         String?

  // Login appearance — colourful themes + user-uploaded background image
  loginTheme      String   @default("aurora")  // aurora | sunset | ocean | rose | emerald | royal
  loginBgUrl      String   @default("")        // data-URL photo shown behind the login card

  // USG (sonography) studio — sonologist signature + print personalisation
  usgDoctorName     String   @default("")
  usgDoctorQual     String   @default("")
  usgDoctorRegNo    String   @default("")
  // v6.1 "Sonologist's Day" — MM-DD; the studio greets the sonologist once
  // a year on this local date. Defaults to 01 Sept (Dr. Sugandha's birthday);
  // empty string turns the greeting off for good.
  usgDoctorBirthday String   @default("09-01")
  usgMachineLine    String   @default("This Scan has been proudly done on GE Voluson Pro 4-D USG Machine")
  usgShowMachine    Boolean  @default(true)
  usgFooterLine     String   @default("Kindly co-relate with clinico-pathological findings.")
  usgDeclarationLine String  @default("") // optional PC-PNDT style declaration under the signature
  usgPrintStyle     String   @default("premium") // premium (gradient letterhead) | classic (plain B/W)
  usgPrintCompact   Boolean  @default(false) // compact density for long studies
  usgPrintPaper     String   @default("a4")    // a4 | a5 (half-sheet for short studies)
  usgSignatureUrl   String   @default("")      // scanned signature image printed over the name line

  // ── v6.2 print fine-tuning (Settings → USG Studio → Print layout) ──────
  // The doctor dials the letterhead to the clinic's paper and printer:
  // body font size (pt), line-height (gaps between lines), section spacing,
  // and whether the Technique band / referral tagline print at all. Shipped
  // defaults (10pt · 1.4 · tight) keep the longest common study — an
  // antenatal scan with the PC-PNDT declaration — on ONE A4 page, signature
  // included; the doctor can dial up in Settings any time.
  usgPrintFontSize     Float   @default(10)    // body pt, clamped 8.5–13
  usgPrintLineHeight   Float   @default(1.4)  // line gaps, clamped 1.15–1.9
  usgPrintSpacing      String  @default("tight") // tight | normal | relaxed (section gaps)
  usgPrintShowTechnique Boolean @default(true) // Technique band on printed reports
  usgPrintShowThanks   Boolean @default(true)  // "Thanks For Your Referral." tagline
  /** Nightly full-clinic backup to data/backups (v5) — off by default. */
  usgAutoBackup     Boolean  @default(false)
  /** HMAC secret for the printed-report verification QR (v5, minted once). */
  qrSecret          String?

  // ── v6 CARE ERP bridge ──────────────────────────────────────────────
  // Bill-desk worklist sync: the ERP exposes /api/internal/reporting-studio/*
  // behind a static x-api-key (REPORTING_STUDIO_API_KEY on the ERP side).
  careApiBase       String   @default("")   // e.g. http://172.16.1.139:8888 (no /api)
  careApiKey        String?                 // secret — never sent to the browser

  // ── v6 Orthanc PACS ─────────────────────────────────────────────────
  orthancUrl        String   @default("")   // e.g. http://172.16.1.139:8042
  orthancUsername   String   @default("")   // empty pair = anonymous (no Basic header)
  orthancPassword   String?                 // secret — never sent to the browser

  // ── v6 optional Vision OCR (Gemini, same contract as the ERP) ───────
  geminiApiKey      String?                 // secret — empty = SR-only extraction

  // ── v6 PC-PNDT Form F fixed details (pre-filled on the statutory form)
  pcpndtCentreName    String   @default("CARE DIAGNOSTICS\nSubhash Chowk, Castair's Town, Near Bajla Mahila College, Deoghar\u2013814112")
  pcpndtRegistrationNo String  @default("34/2020")
  pcpndtPlace         String   @default("DEOGHAR")

  updatedAt       DateTime @updatedAt
}

// ── Sessions for the PIN gate ────────────────────────────────────────────
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ── USG Studio — patient registry ────────────────────────────────────────
// v5: every report is linked to a patient row keyed by normalised
// (name + phone) so repeat scans, follow-up drafts and the patient history
// view all connect. Matching policy is deliberately conservative — a
// blank-phone report never merges into a phone'd patient (same-name
// strangers stay separate); see src/lib/usg/patients.ts.
model UsgPatient {
  id        String   @id @default(cuid())
  name      String
  phone     String   @default("")
  /** lowercase, whitespace-collapsed match key of `name`. */
  normName  String
  /** digits-only match key of `phone` ("" when unknown). */
  normPhone String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports   UsgReport[]

  @@unique([normName, normPhone])
  @@index([normName])
}

// ── USG Studio — standalone sonography reports (Dr Sugandha) ────────────
// Walk-in ultrasound patients with their own drafts, finalize-freeze and
// reprint; not tied to any external worklist.
model UsgReport {
  id            String    @id @default(cuid())
  patientName   String
  patientAge    String    @default("")
  patientSex    String    @default("F") // F | M
  referredBy    String    @default("")
  /** Registry link (v5) — legacy rows keep NULL and still list by name. */
  patientId     String?
  patient       UsgPatient? @relation(fields: [patientId], references: [id])
  studyKey      String    @default("wa-female") // wa-male | wa-female | ua | la-male | la-female
  technique     String    @default("")

  // Full composer state (organs, selected pathologies, variables, overrides)
  stateJson     String    @default("{}")

  // Denormalised for search/listing; resolved from state at save time.
  studyTitle    String    @default("")
  findings      String    @default("")
  impression    String    @default("")

  status        String    @default("DRAFT") // DRAFT | FINALIZED
  reportHtml    String?   // frozen snapshot at finalize
  finalizedAt   DateTime?

  // Register discipline: sequential number stamped at FIRST finalization —
  // printed as USG-0001 and never renumbered, even if an earlier report is
  // deleted. Drafts carry no number until they are finalized.
  serialNo      Int?      @unique
  // Scan date as performed — editable so the doctor can back-date a report
  // typed up after the fact. Printed in the patient strip; falls back to
  // finalizedAt/createdAt when blank.
  scanDate      DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([patientName])
  @@index([createdAt])

  images UsgReportImage[]
}

// ── USG Studio — machine stills attached to a report (v5) ────────────────
// 2–4 sonography stills pasted/dropped onto the draft, printed as a grid on
// the report. Stored as data URLs (machine stills are small); capped at
// 1.5 MB per image at the API. Deleting a report cascades its images.
model UsgReportImage {
  id        String   @id @default(cuid())
  reportId  String
  report    UsgReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  dataUrl   String
  caption   String   @default("")
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
}

// ── USG Studio — audit trail (v5) ────────────────────────────────────────
// Append-only record of every save, finalization, follow-up, deletion,
// image change, settings change, backup and login attempt. The register
// gives the serials discipline; this table gives the trail medico-legal
// review asks for. Rows are never updated or deleted by the app.
model UsgAudit {
  id          String   @id @default(cuid())
  action      String   // report.save | report.finalize | auth.login | …
  reportId    String?
  serialNo    Int?
  patientName String?
  detail      String   @default("")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

// ── USG Studio — normal-wording overrides (v5) ──────────────────────────
// The doctor can retune any builtin organ normal ("Liver appears normal…")
// to her own phrasing without touching code. Keyed by (study, organ); the
// composer applies them at every normal-text resolution point.
model UsgNormalOverride {
  id        String   @id @default(cuid())
  studyKey  String
  organKey  String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studyKey, organKey])
}

// ── USG Studio — user-added custom pathologies ──────────────────────────
// Builtin pathology entries live in code (src/lib/usg/pathologies.ts);
// anything the doctor adds in the UI is persisted here and merged at runtime.
model UsgPathology {
  id            String   @id @default(cuid())
  organKey      String
  label         String
  findingText   String   // may contain {variable} tokens
  impressionLinesJson String @default("[]")
  titleFragment String   @default("")
  sortOrder     Int      @default(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([organKey, label])
}

// ── USG Studio — CARE ERP bill-desk worklist orders (v6) ────────────────
// Pulled from the ERP's /api/internal/reporting-studio/worklist (x-api-key)
// and filtered to ultrasound. One row per accession; the doctor starts a
// report from it so the demographics never need retyping. Rows are never
// deleted by sync — a finalized order stays as the day's record.
model UsgCareOrder {
  id              String    @id @default(cuid())

  // ── Identity (v6.1 fix) ────────────────────────────────────────────────
  // ERP reality: many USG rows carry NO accession number, but always a
  // worklistId (and usually the StudyInstanceUID). accessionNumber is now
  // NULLABLE (SQLite UNIQUE treats NULLs as distinct — unlimited blank
  // orders), never synthesized, and stays the unique legacy bridge where
  // the ERP does populate it. CARE order identity = careWorklistId
  // (deterministic oldest-first resolution — plain index, NOT unique, so
  // legacy duplicates can never fail a NAS boot); imaging identity =
  // studyInstanceUid (exact-match only, see careSync.ts).
  accessionNumber String?   @unique
  careWorklistId  String?

  // Bill-desk demographics (as the ERP reports them; the v6 bridge
  // extension also carries phone/address/bill number — older ERP builds
  // simply leave them blank)
  patientName     String
  patientAge      String    @default("")
  patientSex      String    @default("F")   // F | M
  patientPhone    String    @default("")    // bill desk phone → registry link
  patientAddress  String    @default("")    // Form F prefill
  billNumber      String    @default("")    // Form F prefill
  referringDoctor String    @default("")
  testName        String    @default("")
  modality        String    @default("USG")
  studyDate       DateTime?

  // PACS link (matched by accession during sync)
  studyInstanceUid String?

  billingStatus   String?   // PAID | DUE | UPI_PENDING | null
  billingUpdatedAt DateTime?

  status          String    @default("PENDING") // PENDING | REPORTING | REPORTED | IGNORED
  ignored         Boolean   @default(false)

  reportId        String?   // the UsgReport started from this order
  formFId         String?   // the UsgFormF linked to this order
  careSyncedAt    DateTime? // ERP accepted our finalize

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([studyDate])
  // v6.1 — deterministic identity lookups (plain, NOT unique: legacy
  // duplicates must never fail a NAS boot; resolution is oldest-first).
  @@index([careWorklistId])
  @@index([studyInstanceUid])
}

// ── USG Studio — PC-PNDT Form F records (v6) ────────────────────────────
// The statutory form for every obstetric ultrasound. Demographics are copied
// from the CARE order at open time; fixed clinic details (centre, registration
// no, doctor, place) are resolved from settings at print time. Completeness
// follows the ERP's four-predicate rule (see src/lib/usg/formf.ts).
model UsgFormF {
  id                  String   @id @default(cuid())
  accessionNumber     String   @default("") // link to the CARE order ("" = walk-in)
  billNumber          String   @default("")
  patientName         String
  patientAge          String   @default("")
  husbandFatherName   String   @default("")
  address             String   @default("")
  mobile              String   @default("")
  childrenDetails     String   @default("") // "Boy: 1, Girl: 2"
  referredBy          String   @default("Self") // Self | Doctor: <name>
  lmpWeeks            String   @default("") // "12 weeks" or ISO date
  previousChildIssue  String   @default("")
  indicationOther     String   @default("") // routine antenatal when blank
  gestationalAgeWeeks String   @default("")
  gestationalAgeDays  String   @default("")
  ultrasoundResult    String   @default("") // Normal | Abnormal: <finding>
  abnormality         String   @default("")
  procedureDate       String   @default("")
  consentDate         String   @default("")
  idCardVerified      Boolean  @default(false)
  reportId            String?  // the OB UsgReport this Form F belongs to
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([patientName])
  @@index([accessionNumber])
}

// ── USG Studio — worklist sync state (v6, singleton) ────────────────────
model UsgSyncState {
  id            String    @id @default("singleton")
  lastSyncAt    DateTime?
  lastCareOk    Boolean   @default(false)
  lastOrthancOk Boolean   @default(false)
  lastError     String?
  updatedAt     DateTime  @updatedAt
}
