// CARE Reporting Studio — single-radiologist reporting workspace.
// Schema follows the v1 build spec (Phase 1): additive, SQLite-friendly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Settings (single row, id = "singleton") ─────────────────────────────
model HospitalSettings {
  id              String   @id @default("singleton")

  // Header / identity — the "soul" from CARE ERP
  appTitle        String   @default("CARE Reporting Studio")
  hospitalName    String   @default("")
  addressLine     String   @default("")
  phone           String   @default("")
  email           String   @default("")
  footerMessage   String   @default("")
  logoUrl         String   @default("")

  // Radiologist signature block
  radiologistName     String   @default("")
  radiologistQual     String   @default("")
  radiologistRegNo    String   @default("")

  // Security
  pinHash         String?

  // Login appearance — colourful themes + user-uploaded background image
  loginTheme      String   @default("aurora")  // aurora | sunset | ocean | rose | emerald | royal
  loginBgUrl      String   @default("")        // data-URL photo shown behind the login card

  // Integrations (secrets — never returned unmasked to the client)
  careApiBase     String   @default("")
  careApiKey      String   @default("")
  orthancUrl      String   @default("")
  orthancUsername String   @default("")
  orthancPassword String   @default("")
  ohifLanUrl      String   @default("")
  ohifTailscaleUrl String  @default("")

  // USG (sonography) studio — Dr Sugandha's standalone ultrasound reporting.
  // Sonologist signature is separate from the radiologist block above.
  usgDoctorName     String   @default("")
  usgDoctorQual     String   @default("")
  usgDoctorRegNo    String   @default("")
  usgMachineLine    String   @default("This Scan has been proudly done on GE Voluson Pro 4-D USG Machine")
  usgShowMachine    Boolean  @default(true)
  usgFooterLine     String   @default("Kindly co-relate with clinico-pathological findings.")
  usgDeclarationLine String  @default("") // optional PC-PNDT style declaration under the signature
  usgPrintStyle     String   @default("premium") // premium (gradient letterhead) | classic (plain B/W)
  usgPrintCompact   Boolean  @default(false) // compact density for long studies
  usgPrintPaper     String   @default("a4")    // a4 | a5 (half-sheet for short studies)
  usgSignatureUrl   String   @default("")      // scanned signature image printed over the name line

  updatedAt       DateTime @updatedAt
}

// ── Sessions for the PIN gate ────────────────────────────────────────────
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ── CARE worklist bridge ────────────────────────────────────────────────
model CareOrderLink {
  id              String   @id @default(cuid())
  accessionNumber String   @unique
  careWorklistId  String?
  patientMrn      String?
  patientName     String
  patientAge      String?
  patientGender   String?
  referringDoctor String?
  testName        String?
  modality        String   @default("MR") // MR | CT
  bodyRegion      String   @default("")   // LS Spine / Cervical Spine / Brain / CT Head …
  studyInstanceUid String?
  billingStatus   String?  // PAID | DUE | UPI_PENDING | null
  billingUpdatedAt DateTime?
  studyDate       DateTime?
  status          String   @default("AWAITING_IMAGES") // AWAITING_IMAGES | TO_REPORT | REPORTING | REPORTED
  ignored         Boolean  @default(false)             // Unlinked bucket "Ignore"
  report          Report?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([patientName])
}

// ── Complete report formats (one-click full report) ─────────────────────
// A format fills the ENTIRE report in one tap: study title, technique,
// findings scaffold, impression lines and recommendation. Formats expand
// to FindingRows (single source of truth) — later phrase additions
// append to the compiled sections and recompose the study title.
model ReportFormat {
  id          String  @id @default(cuid())
  key         String  @unique        // "mr-brain-fazekas1-senile"
  modality    String  @default("MR") // MR | CT
  region      String                // Brain / LS Spine / Cervical Spine / CT Head / CT Spine
  name        String                // "Fazekas Grade 1 + Senile Changes"
  studyTitle  String                // "MRI BRAIN"
  titleSuffix String  @default("")  // "fazekas grade 1 changes and senile changes"
  technique   String  @default("")
  recommendation String @default("")
  rowsJson    String  @default("[]") // JSON: FormatRowSeed[]
  isNormal    Boolean @default(false)
  isBuiltin   Boolean @default(true)
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())

  @@index([modality, region])
}

// ── Reports ─────────────────────────────────────────────────────────────
model Report {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         CareOrderLink @relation(fields: [orderId], references: [id], onDelete: Cascade)

  technique     String   @default("")
  findings      String   @default("")   // compiled findings text (informational)
  impression    String   @default("")   // compiled impression (or manual)
  impressionManual Boolean @default(false)
  recommendation String  @default("")

  // Study heading is the SHORT title ("MRI BRAIN"). The composed phrase
  // ("MRI BRAIN WITH FAZEKAS GRADE 1 CHANGES AND SENILE CHANGES") lives as
  // the bold opening line of FINDINGS — never in the heading.
  formatKey     String?                // applied ReportFormat.key
  studyBase     String?                // "MRI BRAIN" — the printed heading
  titleSuffix   String?                // format suffix, stored at apply time
  studyName     String?                // display heading (= studyBase unless manual)
  titleManual   Boolean  @default(false)
  findingsOpening String?              // bold opening line inside FINDINGS
  openingManual  Boolean @default(false) // user edited the opening line

  status        String   @default("DRAFT") // DRAFT | FINALIZED
  reportHtml    String?                  // frozen snapshot at finalize
  finalizedAt   DateTime?
  careSyncedAt  DateTime?                // set when CARE finalize succeeded

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  findingRows   FindingRow[]
  images        ReportImage[]
}

// ── Key images printed with the report (captured from OHIF or uploaded) ──
model ReportImage {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  dataUrl   String                // base64 JPEG/PNG data URL (≤ ~1.5 MB)
  caption   String   @default("")
  source    String   @default("capture") // capture | upload
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([reportId])
}

// ── Atomic findings (R2-mini ledger) ────────────────────────────────────
model FindingRow {
  id         String   @id @default(cuid())
  reportId   String
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  region     String
  concept    String   // disc_contour | canal_stenosis | fazekas | note | …
  level      String?
  laterality String?  // left | right | bilateral
  severity   String?  // mild | moderate | severe | …
  text       String
  inImpression Boolean @default(true)
  // Format-system extras:
  titleFragment String?              // "chronic infarct" — joins the study title
  newParagraph  Boolean @default(false) // start a new paragraph in findings
  impressionOnly Boolean @default(false) // excluded from findings, numbered in impression
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([reportId])
}

// ── Quick phrases (chips) ───────────────────────────────────────────────
model QuickPhrase {
  id         String   @id @default(cuid())
  region     String   // LS Spine / Cervical Spine / Brain / CT Head / CT Spine
  modality   String   @default("MR")
  label      String
  concept    String
  level      String?
  laterality String?
  severity   String?
  text       String
  titleFragment String?             // "chronic infarct" — copied to the row, joins the title
  sortOrder  Int      @default(0)
  @@unique([modality, region, label])
}

// ── Technique templates ─────────────────────────────────────────────────
model TechniqueTemplate {
  id        String  @id @default(cuid())
  region    String
  modality  String  @default("MR")
  text      String
  @@unique([modality, region])
}

// ── Worklist sync state (singleton) ─────────────────────────────────────
model SyncState {
  id           String   @id @default("singleton")
  lastSyncAt   DateTime?
  lastCareOk   Boolean  @default(false)
  lastOrthancOk Boolean @default(false)
  lastError    String?
}

// ── USG Studio — standalone sonography reports (Dr Sugandha) ────────────
// Not tied to the CARE worklist: walk-in ultrasound patients with their own
// drafts, finalize-freeze and reprint, exactly like the reporting pipeline.
model UsgReport {
  id            String    @id @default(cuid())
  patientName   String
  patientAge    String    @default("")
  patientSex    String    @default("F") // F | M
  referredBy    String    @default("")
  studyKey      String    @default("wa-female") // wa-male | wa-female | ua | la-male | la-female
  technique     String    @default("")

  // Full composer state (organs, selected pathologies, variables, overrides)
  stateJson     String    @default("{}")

  // Denormalised for search/listing; resolved from state at save time.
  studyTitle    String    @default("")
  findings      String    @default("")
  impression    String    @default("")

  status        String    @default("DRAFT") // DRAFT | FINALIZED
  reportHtml    String?   // frozen snapshot at finalize
  finalizedAt   DateTime?

  // Register discipline: sequential number stamped at FIRST finalization —
  // printed as USG-0001 and never renumbered, even if an earlier report is
  // deleted. Drafts carry no number until they are finalized.
  serialNo      Int?      @unique
  // Scan date as performed — editable so the doctor can back-date a report
  // typed up after the fact. Printed in the patient strip; falls back to
  // finalizedAt/createdAt when blank.
  scanDate      DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([patientName])
  @@index([createdAt])
}

// ── USG Studio — user-added custom pathologies ──────────────────────────
// Builtin pathology entries live in code (src/lib/usg/pathologies.ts);
// anything the doctor adds in the UI is persisted here and merged at runtime.
model UsgPathology {
  id            String   @id @default(cuid())
  organKey      String
  label         String
  findingText   String   // may contain {variable} tokens
  impressionLinesJson String @default("[]")
  titleFragment String   @default("")
  sortOrder     Int      @default(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([organKey, label])
}
