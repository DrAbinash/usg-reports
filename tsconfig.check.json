{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/components/studio/*.tsx",
    "src/lib/*.ts",
    "src/app/api/**/*.ts",
    "src/app/layout.tsx",
    "src/app/page.tsx"
  ],
  "exclude": ["node_modules"]
}
