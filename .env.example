# CARE USG Studio — environment
# Copy to .env beside docker-compose.yml and edit.

# Port the studio answers on (Synology host) — 3040 so it never clashes
# with the MRI studio's 3090 on the same NAS.
STUDIO_PORT=3040

# Timezone
TZ=Asia/Kolkata

# ── CARE ERP bridge (bill-desk worklist + finalize sync) ────────────────
# The ERP's base URL WITHOUT /api (the app appends /api/internal/...):
CARE_API_BASE=http://172.16.1.139:8888
# The same static key the ERP has in REPORTING_STUDIO_API_KEY:
CARE_API_KEY=

# ── Orthanc PACS (USG machine pushes studies here) ──────────────────────
ORTHANC_URL=http://172.16.1.139:8042
ORTHANC_USERNAME=
ORTHANC_PASSWORD=

# ── OHIF Viewer (DICOM image viewing from the studio) ───────────────────
# Defaults only — Settings → Integrations → OHIF Viewer is the source of
# truth and a value saved there always wins. No code edit is needed to move
# the viewer.
OHIF_LAN_URL=http://172.16.1.139:3010
# Canonical HTTPS endpoint — the clinic's own viewer front door, the same one
# CARE ERP embeds. Being https it can be framed by an https studio page (a plain
# http:// viewer cannot — the browser blocks the iframe as mixed content), and
# because it is a hostname rather than a subpath OHIF keeps serving its assets
# and its relative /dicom-web data from one origin. This is what AUTO prefers
# once the LAN viewer turns out to be unembeddable on the page.
OHIF_CUSTOM_URL=https://ohif.caredeoghar.com
# A same-origin path (e.g. /ohif) also works in the field above, but only after
# enabling the commented Caddy proxy route AND rebuilding OHIF with
# PUBLIC_URL=/ohif — the hostname form needs neither.
# Tailscale route — optional, and blank by default. A .ts.net name resolves only
# inside the tailnet (MagicDNS), so it answers for neither the studio container
# nor a browser without a Tailscale client; set it only where both are members.
# Get your own address with:
#   docker exec care-tailscale-ohif tailscale serve status
# Left blank the route is never guessed — AUTO simply skips it.
OHIF_TAILSCALE_URL=
# auto | lan | tailscale | custom
OHIF_MODE=auto
# AUTO reachability budget (ms). A dead endpoint must never stall reporting.
OHIF_PROBE_TIMEOUT_MS=1500
OHIF_PROBE_GET_TIMEOUT_MS=2500
OHIF_PROBE_CACHE_MS=60000
OHIF_PROBE_FAIL_CACHE_MS=15000

# Pre-fill the blanks above into a fresh install's Settings → Integrations.
# Values saved in the app always win over these.
INTEGRATION_DEFAULTS=on
