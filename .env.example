# CARE USG Studio — environment
# Copy to .env beside docker-compose.yml and edit.

# Port the studio answers on (Synology host)
STUDIO_PORT=3090

# Timezone
TZ=Asia/Kolkata

# Nothing else to configure — this studio is fully standalone:
# no CARE ERP bridge, no Orthanc PACS, no OHIF viewer. Personalisation
# (letterhead, sonologist block, print style) lives in the app's Settings,
# and travels between machines via Settings → USG Studio → Backup.
