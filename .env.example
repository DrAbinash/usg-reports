# =============================================================================
# CARE AI Sonologist Companion™ — Environment Configuration
# Copy this file to .env and edit the values for your Synology NAS
# =============================================================================

# === APPLICATION ===
APP_PORT=3090
TZ=Asia/Kolkata

# === DATABASE ===
# SQLite — path is INSIDE the container, data/db is mounted as a volume
DATABASE_URL=file:/app/data/db/usg_companion.db