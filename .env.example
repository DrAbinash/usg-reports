# CARE Reporting Studio — environment
# Copy to .env beside docker-compose.yml and edit.

# Port the studio answers on (Synology host)
STUDIO_PORT=3090

# Timezone
TZ=Asia/Kolkata

# Where your existing OHIF listens (care-pacs compose on the same NAS).
# Only needed for the optional /ohif same-origin viewer (see Caddyfile).
OHIF_UPSTREAM=172.16.1.139:3010

# ── Integration defaults (ship-with-defaults) ─────────────────────────────
# The studio opens with the clinic LAN preconfigured (CARE http://172.16.1.139:8888,
# Orthanc http://172.16.1.139:8042, OHIF http://172.16.1.139:3010), so after
#   git pull && sudo docker compose up -d --build
# Settings → Integrations is already filled and the Test buttons just work —
# on a fresh database too. Anything you SAVE in the app still wins over these.
#
# REQUIRED (secret — never committed to git): the CARE internal API key,
# same value as REPORTING_STUDIO_API_KEY in the CARE ERP .env.
CARE_API_KEY=

# Optional overrides for the built-in LAN defaults (leave unset normally):
# CARE_API_BASE=http://172.16.1.139:8888
# ORTHANC_URL=http://172.16.1.139:8042
# ORTHANC_USERNAME=
# ORTHANC_PASSWORD=
# OHIF_LAN_URL=http://172.16.1.139:3010
# OHIF_TAILSCALE_URL=

# Set to "off" to keep cleared Settings fields blank (no LAN defaults):
# INTEGRATION_DEFAULTS=off
