# CARE USG Studio — environment
# Copy to .env beside docker-compose.yml and edit.

# Port the studio answers on (Synology host) — 3040 so it never clashes
# with the MRI studio's 3090 on the same NAS.
STUDIO_PORT=3040

# Timezone
TZ=Asia/Kolkata

# ── CARE ERP bridge (bill-desk worklist + finalize sync) ────────────────
# The ERP's base URL WITHOUT /api (the app appends /api/internal/...):
CARE_API_BASE=http://172.16.1.139:8888
# The same static key the ERP has in REPORTING_STUDIO_API_KEY:
CARE_API_KEY=

# ── Orthanc PACS (USG machine pushes studies here) ──────────────────────
ORTHANC_URL=http://172.16.1.139:8042
ORTHANC_USERNAME=
ORTHANC_PASSWORD=

# Pre-fill the blanks above into a fresh install's Settings → Integrations.
# Values saved in the app always win over these.
INTEGRATION_DEFAULTS=on
